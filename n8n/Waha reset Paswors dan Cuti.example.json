    {
      "parameters": {
        "jsCode": "const NL = String.fromCharCode(10); const body = $input.first().json.body || {}; const rawPhone = String(body.nomor_wa || body.nomor_wa_atasan || '').replace(/[^0-9]/g, ''); const normPhone = rawPhone.startsWith('0') ? ('62' + rawPhone.substring(1)) : rawPhone; const chatId = normPhone + '@c.us'; const jenis = String(body.jenis_pesan || 'direct'); const textReset = '*TRANSKEP - RESET SANDI SEMENTARA* 🏢' + NL + NL + 'Halo *' + (body.nama || 'Pegawai') + '*,' + NL + NL + 'Permintaan reset kata sandi akun TRANSKEP Anda berhasil diproses.' + NL + 'Berikut kredensial masuk sementara Anda:' + NL + NL + '👤 *NIP:* ' + (body.nip || '-') + NL + '🔑 *Sandi Sementara:* *' + (body.password_baru || '-') + '*' + NL + NL + '⚠️ *Perhatian:* Segera login ke portal dan perbarui kata sandi Anda di menu profil demi keamanan akun.' + NL + NL + '🔗 *Link Login Portal:* https://sso.pa-indramayu.go.id/'; const textUsulan = '*TRANSKEP - USULAN CUTI PEGAWAI* 📋' + NL + NL + 'Yth. Bapak/Ibu *' + (body.nama_tujuan || 'Atasan Langsung') + '*,' + NL + NL + 'Terdapat pengajuan cuti yang membutuhkan persetujuan Anda:' + NL + NL + '👤 *Pemohon:* ' + (body.nama_pemohon || '-') + NL + '🏷️ *Jenis:* Cuti ' + (body.jenis_cuti || '-') + NL + '📅 *Periode:* ' + (body.periode || '-') + ' (' + (body.durasi || '-') + ' hari)' + NL + '📝 *Alasan:* ' + (body.alasan || '-') + NL + NL + 'Silakan klik tautan di bawah ini untuk melihat detail dan memberikan persetujuan langsung:' + NL + '👉 ' + (body.magic_link || 'https://sso.pa-indramayu.go.id/'); const textKeputusan = '*TRANSKEP - STATUS USULAN CUTI* 📢' + NL + NL + 'Halo *' + (body.nama_pemohon || 'Pegawai') + '*,' + NL + NL + 'Status permohonan cuti Anda (Periode: ' + (body.periode || '-') + ') telah diperbarui:' + NL + NL + '📌 *Status:* *' + (body.status || '-') + '*' + NL + '👤 *Oleh:* ' + (body.oleh || '-') + NL + '📝 *Catatan:* ' + (body.catatan || '-') + NL + NL + '🔗 Silakan cek status lengkap di portal: https://sso.pa-indramayu.go.id/'; const textDirect = String(body.pesan || 'Notifikasi Sistem TRANSKEP'); return [{ json: { jenis_pesan: jenis, chatId, textReset, textUsulan, textKeputusan, textDirect } }];"
      },
