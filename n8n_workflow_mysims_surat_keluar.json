    {
      "parameters": {
        "jsCode": "// Ekstraksi Nomor Surat Keluar Resmi dari Baris Teratas Tabel MYSIMS\nconst rawHtml = String($input.first().json.data || $input.first().json.body || $input.first().json || '');\nconst prepData = $('Parse Session & Prepare Form').first().json;\n\nlet nomorSuratFound = '';\n\n// 1. Regex spesifik format nomor surat PA Indramayu: e.g. 1085/KPA.W10-A2/KP5.3/XI/2026\nconst regexSurat = /(\\d+\\/KPA\\.W10-A2\\/[A-Za-z0-9.]+\\/[IVXLCDM]+\\/\\d{4})/i;\nconst match1 = rawHtml.match(regexSurat);\nif (match1 && match1[1]) {\n  nomorSuratFound = match1[1].trim();\n} else {\n  // 2. Fallback pencarian nomor prefix KPA.W10-A2\n  const subMatch = rawHtml.match(/(\\d{3,5}\\/KPA\\.W10-A2[^<\"'\\s]+)/i);\n  if (subMatch && subMatch[1]) {\n    nomorSuratFound = subMatch[1].trim();\n  }\n}\n\nreturn [{\n  json: {\n    cuti_id: prepData.cuti_id,\n    nomor_surat: nomorSuratFound || 'NOMOR_MYSIMS_TERCATAT',\n    secret_key: prepData.secret_key,\n    callback_url: prepData.callback_url,\n    nama_pegawai: prepData.nama_pegawai,\n    debug_cookie_sent: prepData.session_cookie ? 'ADA' : 'KOSONG'\n  }\n}];"
      },
