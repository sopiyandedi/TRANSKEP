    {
      "parameters": {
        "jsCode": "// Ekstraksi Cookie Sesi MYSIMS dari Header Respons Login (302 Redirect)\nconst loginNode = $('Login MYSIMS').first().json || {};\nconst headers = loginNode.headers || {};\nconst rawCookies = headers['set-cookie'] || [];\nlet cookies = [];\n\nif (Array.isArray(rawCookies)) {\n  for (const c of rawCookies) {\n    if (c) cookies.push(c.split(';')[0].trim());\n  }\n} else if (typeof rawCookies === 'string' && rawCookies.trim() !== '') {\n  cookies.push(rawCookies.split(';')[0].trim());\n}\n\n// Gabungkan semua cookie (ci_session, PHPSESSID, dsb)\nconst sessionCookie = cookies.join('; ');\n\n// Ambil payload dari trigger TRANSKEP\nconst webhookData = $('Webhook Trigger').first().json.body || $('Webhook Trigger').first().json || {};\nconst mysims = webhookData.mysims_payload || {};\n\n// Format tanggal surat (YYYY-MM-DD)\nconst todayYmd = mysims.tgl_surat || new Date().toISOString().slice(0, 10);\n\nreturn [{\n  json: {\n    session_cookie: sessionCookie,\n    cuti_id: webhookData.cuti_id || '',\n    nama_pegawai: webhookData.nama_pegawai || '',\n    nip: webhookData.nip || '',\n    jenis_cuti: webhookData.jenis_cuti || '',\n    callback_url: webhookData.callback_url || '',\n    secret_key: webhookData.secret_key || 'TRANSKEP_WA_BOT_2026',\n    mysims_dari: mysims.dari || webhookData.nama_pegawai || 'Pegawai',\n    mysims_uraian: mysims.uraian || ('Permohonan Cuti ' + (webhookData.jenis_cuti || '') + ' a.n. ' + (webhookData.nama_pegawai || 'Pegawai')),\n    mysims_kode: mysims.kode || 'KP5.3',\n    mysims_tgl_surat: todayYmd,\n    mysims_sifat: mysims.sifat || 'Biasa',\n    mysims_ket: mysims.ket || 'cuti tahunan'\n  }\n}];"
      },
